# --- Databasis Konfigurasie ---
DB_USER=postgres
DB_PASS=changeme
DB_NAME=MOON
DB_HOST=db

# Hierdie is nodig vir die amptelike Postgres beeld in Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=MOON

# --- Sekuriteit ---
# Genereer met: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Enable/disable CSV import/export functionality (default: true)
CSV_IMPORT_EXPORT_ENABLED=true

# Dalk nodig vir publieke RSVP-skakels (moet leeg wees vir produksie)
# PUBLIC_SITE_BASE_URL=https://jou-domein.co.za
