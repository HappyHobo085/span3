# --- Databasis Konfigurasie ---
DB_USER=postgres
DB_PASS=changeme
DB_NAME=MOON
DB_HOST=db

# Postgres verbindings-poel (opsioneel)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# Hierdie is nodig vir die amptelike Postgres beeld in Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=MOON

# --- Sekuriteit ---
# Genereer met: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Opsioneel: aparte sleutel vir sessiekoekies (val terug na SECRET_KEY)
# SESSION_SECRET_KEY=

# Omgewing: development | production (beveilig koekie secure-vlag)
ENVIRONMENT=development

# CORS: komma-geskeide lys van oorsprone
# Let wel: production moet slegs spesifieke domeine lys
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8000

# Enable/disable CSV import/export functionality (default: true)
CSV_IMPORT_EXPORT_ENABLED=true

# Dalk nodig vir publieke RSVP-skakels (moet leeg wees vir produksie)
# PUBLIC_SITE_BASE_URL=https://jou-domein.co.za
